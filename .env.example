# Copie este archivo a .env.local (NUNCA suba .env.local a Git)

# PÚBLICAS: la configuración web de Firebase es pública por diseño
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# SOLO SERVIDOR (clave privada del Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# En Vercel va con \n literales; src/lib/firebase-admin.ts los convierte
FIREBASE_PRIVATE_KEY=
